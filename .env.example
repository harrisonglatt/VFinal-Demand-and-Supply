# ════════════════════════════════════════════════════════════════
# Little Spoon Retail OS — V-Final Demand & Supply
# Copy this file to .env.local (local dev) or paste into Vercel
# Project Settings → Environment Variables (production).
#
# Verified against codebase — these are the ONLY env vars read.
# ════════════════════════════════════════════════════════════════

# ── Owlery — live PO data ────────────────────────────────────────
# Powers /po-tracker. Without it, the app falls back to mock POs.
# Docs: https://owleryai.docs.apiary.io
OWLERY_API_KEY=

# Feature flag — enable only after Owlery exposes /orders endpoint.
OWLERY_ORDERS_ENABLED=false

# ── Anthropic — AI Executive insights ────────────────────────────
# Powers the "So What" card on /executive (cached 30 min).
# Without it, the page uses rule-based fallback insights.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
